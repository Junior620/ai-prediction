//@version=5
// CocoaTrack — lecture de marche pour alertes / Brief IA
// IMPORTANT: ajouter cet indicateur UNIQUEMENT sur le symbole ICEEUR:C1!
// Chart: https://www.tradingview.com/chart/?symbol=ICEEUR%3AC1%21
// (Cacao futures Londres). Le dashboard affiche PEPPERSTONE:COCOA pour le
// graphique uniquement ; les alertes et briefs Claude partent de Londres.
indicator("CocoaTrack Market Reading", overlay=true, max_labels_count=50, max_lines_count=10)

// ── Parametres ──────────────────────────────────────────
lenMaFast   = input.int(20, "MA rapide")
lenMaSlow   = input.int(50, "MA lente")
lenRsi      = input.int(14, "RSI")
lenSupport  = input.int(20, "Lookback support/resistance")
volLen      = input.int(20, "Lookback volume")
// Colle ici TRADINGVIEW_WEBHOOK_SECRET depuis ton .env (Settings de l'indicateur)
webhookSecret = input.string("REMPLACER_PAR_VOTRE_SECRET", "Webhook secret", group="API SCPB")

// Symbole attendu pour les alertes (futures cacao Londres)
ALERT_TICKER = "ICEEUR:C1!"
API_MARKET   = "ICE_NY"

// Accepte ICEEUR:C1! ou C1! selon le format renvoye par TradingView
isTargetSymbol =
     str.upper(syminfo.tickerid) == ALERT_TICKER
  or str.upper(syminfo.ticker) == "C1!"
  or str.contains(str.upper(syminfo.tickerid), "C1!")

// ── Indicateurs ─────────────────────────────────────────
maFast = ta.sma(close, lenMaFast)
maSlow = ta.sma(close, lenMaSlow)
rsiVal = ta.rsi(close, lenRsi)
supportLvl = ta.lowest(low, lenSupport)
resistLvl  = ta.highest(high, lenSupport)
volAvg = ta.sma(volume, volLen)
volRatio = volAvg > 0 ? volume / volAvg : 1.0
changePct = ((close - close[1]) / close[1]) * 100.0

// Tendance de fond
trendStr = maFast > maSlow ? "bullish" : maFast < maSlow ? "bearish" : "neutral"

// Momentum (RSI)
momentumStr = rsiVal >= 70 ? "strong_buy" : rsiVal >= 55 ? "buy" : rsiVal <= 30 ? "strong_sell" : rsiVal <= 45 ? "sell" : "neutral"

// Position vs moyennes
priceVsMa = close > maFast and close > maSlow ? "above" : close < maFast and close < maSlow ? "below" : "mixed"

// Evenements
breakSupport    = ta.crossunder(close, supportLvl)
breakResistance = ta.crossover(close, resistLvl)
trendFlipUp     = ta.crossover(maFast, maSlow)
trendFlipDown   = ta.crossunder(maFast, maSlow)

plot(maFast, "MA rapide", color=color.new(color.orange, 0), linewidth=2)
plot(maSlow, "MA lente", color=color.new(color.blue, 30), linewidth=2)

// Support / resistance : lignes horizontales courantes uniquement
// (plotter toute l'historique cree des "murs" verticaux sur le contrat continu C1!)
var line supportLine = na
var line resistLine = na
if barstate.islast
    if not na(supportLine)
        line.delete(supportLine)
    if not na(resistLine)
        line.delete(resistLine)
    supportLine := line.new(bar_index - lenSupport, supportLvl, bar_index + 10, supportLvl, color=color.new(color.green, 20), width=1, style=line.style_dashed, extend=extend.none)
    resistLine := line.new(bar_index - lenSupport, resistLvl, bar_index + 10, resistLvl, color=color.new(color.red, 20), width=1, style=line.style_dashed, extend=extend.none)

// Avertissement visuel si le script n'est pas sur ICEEUR:C1!
bgcolor(isTargetSymbol ? na : color.new(color.red, 92), title="Mauvais symbole")

// ── Alertes JSON (webhook -> API -> Claude) ─────────────
f_alert_json(signalType) =>
    '{"secret":"' + webhookSecret +
     '","market":"' + API_MARKET +
     '","signal_type":"' + signalType +
     '","price":' + str.tostring(close, "#.##") +
     ',"tf":"' + timeframe.period +
     '","ticker":"' + ALERT_TICKER +
     '","indicator":"CocoaTrack Market Reading"' +
     ',"trend":"' + trendStr +
     '","momentum":"' + momentumStr +
     '","change_pct":' + str.tostring(changePct, "#.##") +
     ',"rsi":' + str.tostring(rsiVal, "#.##") +
     ',"price_vs_ma":"' + priceVsMa +
     '","support":' + str.tostring(supportLvl, "#.##") +
     ',"resistance":' + str.tostring(resistLvl, "#.##") +
     ',"volume_ratio":' + str.tostring(volRatio, "#.##") +
     ',"message":"Lecture cacao Londres ICEEUR:C1!"' +
     ',"timestamp":"' + str.tostring(timenow) +
     '","mode":"standard","force_refresh":true}'

// N'envoie des alertes QUE sur ICEEUR:C1!
if isTargetSymbol and breakSupport
    alert(f_alert_json("support_break"), alert.freq_once_per_bar_close)

if isTargetSymbol and breakResistance
    alert(f_alert_json("resistance_break"), alert.freq_once_per_bar_close)

if isTargetSymbol and trendFlipUp
    alert(f_alert_json("trend_change"), alert.freq_once_per_bar_close)

if isTargetSymbol and trendFlipDown
    alert(f_alert_json("trend_change"), alert.freq_once_per_bar_close)

if isTargetSymbol and ta.crossunder(rsiVal, 30)
    alert(f_alert_json("sell"), alert.freq_once_per_bar_close)

if isTargetSymbol and ta.crossover(rsiVal, 70)
    alert(f_alert_json("buy"), alert.freq_once_per_bar_close)
