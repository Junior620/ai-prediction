# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=http://localhost:5000

# Data Source API Keys
ICE_LONDON_API_URL=https://api.ice.com/london
ICE_LONDON_API_KEY=your-ice-london-api-key

ICE_NY_API_URL=https://api.ice.com/ny
ICE_NY_API_KEY=your-ice-ny-api-key

WEATHER_API_URL=https://api.weatherapi.com/v1
WEATHER_API_KEY=your-weather-api-key

ICCO_API_URL=https://api.icco.org/v1
ICCO_API_KEY=your-icco-api-key

FX_RATES_API_URL=https://api.exchangerate-api.com/v4
FX_RATES_API_KEY=your-fx-rates-api-key

REUTERS_API_URL=https://api.reuters.com/v1
REUTERS_API_KEY=your-reuters-api-key

BLOOMBERG_API_URL=https://api.bloomberg.com/v1
BLOOMBERG_API_KEY=your-bloomberg-api-key

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# JWT service token for batch scripts / Streamlit (python generate_jwt_token.py)
API_TOKEN=
# Browser origins allowed for CORS (comma-separated). Include your Vercel URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Alert System (Optional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@cocoatrading.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
