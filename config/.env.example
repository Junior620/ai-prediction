# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MLflow Configuration
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_REGISTRY_URI=./mlruns

# Data Source API Keys
ICE_LONDON_API_URL=https://api.ice.com/london
ICE_LONDON_API_KEY=your-ice-london-api-key

ICE_NY_API_URL=https://api.ice.com/ny
ICE_NY_API_KEY=your-ice-ny-api-key

WEATHER_API_URL=https://api.weatherapi.com
WEATHER_API_KEY=your-weather-api-key

ICCO_API_URL=https://api.icco.org
ICCO_API_KEY=your-icco-api-key

FOREX_API_URL=https://api.exchangerate-api.com
FOREX_API_KEY=your-forex-api-key

REUTERS_API_URL=https://api.reuters.com
REUTERS_API_KEY=your-reuters-api-key

BLOOMBERG_API_URL=https://api.bloomberg.com
BLOOMBERG_API_KEY=your-bloomberg-api-key

# Databento — ICE London Cocoa (OHLCV / Open Interest)
DATABENTO_API_KEY=

# Security
JWT_SECRET_KEY=your-secret-key-change-this-in-production
