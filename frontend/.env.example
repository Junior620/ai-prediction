# ── Client (exposé au navigateur) ─────────────────────────
# Host public de l'API (WebSocket uniquement). Pas de secret ici.
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ── Server-only (Vercel / Next — jamais NEXT_PUBLIC_) ─────
# URL backend pour le BFF /api/backend et le webhook TradingView
API_BACKEND_URL=https://your-api-domain.com

# JWT service (generate_jwt_token.py) — injecté par le BFF
API_TOKEN=your-service-jwt-token
