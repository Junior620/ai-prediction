# ── Client (expose au navigateur) ─────────────────────────
# URL publique de l'API FastAPI (predictions, brief, etc.)
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# JWT long-lived pour le dashboard (Bearer)
NEXT_PUBLIC_API_TOKEN=your-production-jwt-token

# ── Server-only (Vercel, jamais expose au navigateur) ─────
# Utilise par le proxy webhook TradingView
# En general identique a NEXT_PUBLIC_API_URL
API_BACKEND_URL=https://your-api-domain.com
